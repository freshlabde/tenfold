<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  tenfold static server, kept alive by launchd (macOS host).
  Serves the PWA on 127.0.0.1:7710 for a reverse proxy or tunnel.
  Static files and the ciphertext mailbox only - no plaintext user data.

  This file is a TEMPLATE: replace every /path/to placeholder with the
  absolute paths of your machine (launchd resolves no $HOME and no PATH),
  then:
    cp tools/com.tenfold.serve.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tenfold.serve.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tenfold.serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/node</string>
    <string>/path/to/tenfold/tools/serve.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/tenfold</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- The model relay's allowlist: exact OpenAI-compatible base URLs the
         relay may forward to (comma-separated). Empty or absent = the relay
         only accepts the built-in cloud hosts. -->
    <key>TENFOLD_LLM_UPSTREAMS</key>
    <string>http://127.0.0.1:1234/v1</string>
    <!-- Operator contact in the Web-Push VAPID claim. Operator data, never
         user data. -->
    <key>TENFOLD_PUSH_SUBJECT</key>
    <string>mailto:info@freshlab.es</string>
    <!-- Visitor counters, OFF unless this key is set. With it, the server
         counts document loads per UTC day (loads, distinct visitors, referrer
         hosts, countries, mobile/desktop, bots) and shows them at
         /stats?k=<the key>. Aggregates only: no IP, no user agent, no cookie
         and no identifier is ever written. Leave it out and nothing is
         counted and the page does not exist. Use a long random string. -->
    <!--
    <key>TENFOLD_STATS_KEY</key>
    <string>replace-with-a-long-random-string</string>
    -->
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/tenfold-serve.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tenfold-serve.log</string>
</dict>
</plist>
